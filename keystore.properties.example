# Copy this file to `keystore.properties` (gitignored) and fill in real values.
# Place your keystore at `app/upload-keystore.jks` (storeFile is resolved relative to the app/ module).
# CI does not read this file; it sources the same values from GitHub Secrets via env vars.
storeFile=upload-keystore.jks
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=upload
keyPassword=YOUR_KEY_PASSWORD
